{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git remote -v)",
      "Bash(uv --version)",
      "Bash(uv tree)",
      "Bash(uv tree *)",
      "Bash(uv pip list)",
      "Bash(uv pip list *)",
      "Bash(uv pip show)",
      "Bash(uv pip show *)"
    ],
    "deny": [
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git show *--output*)"
    ]
  }
}
